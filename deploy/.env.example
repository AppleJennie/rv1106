# ============================================================
# Bus DMS Server 配置示例
# 用法：cp .env.example .env，然后按实际环境修改
# ============================================================

# 服务监听端口。
# ⚠️ 8099 仅开发用占位！正式端口等腾讯云控制台放行后确定。
# ⚠️ 服务器上 8000 / 8003 已被 xiaozhi-esp32-server 占用，严禁使用。
DMS_BUS_PORT=8099

# 监听地址。开发默认只监听本机；正式部署改为 0.0.0.0。
DMS_BUS_HOST=127.0.0.1

# SQLite 数据库文件路径（相对路径基于 server/ 工作目录）。
DMS_BUS_DB_PATH=./data/dms_bus.db

# 日志级别：DEBUG / INFO / WARNING / ERROR
DMS_BUS_LOG_LEVEL=INFO

# SQLite 备份目录（backup_db.sh 使用，相对路径基于 server/ 工作目录）。
DMS_BUS_BACKUP_DIR=./backup

# 备份保留天数（backup_db.sh 清理更老的备份）。
DMS_BUS_BACKUP_KEEP_DAYS=14

# uvicorn worker 数。SQLite 单写者模型，固定 1，请勿调大。
DMS_BUS_WORKERS=1
